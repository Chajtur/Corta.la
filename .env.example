NODE_ENV=development
PORT=3000
BASE_URL=https://corta.la
DB_HOST=localhost
DB_PORT=3306
DB_USER=corta_la
DB_PASSWORD=
DB_NAME=corta_la

# Use a long, random value (at least 32 bytes) and keep it stable across deploys.
SESSION_SECRET=replace-with-a-long-random-secret
FREE_URL_TTL_DAYS=30

# Set both reCAPTCHA values in production. For local development only:
REQUIRE_CAPTCHA=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.7
SHORTEN_RATE_LIMIT=10
SHORTEN_RATE_WINDOW_MINUTES=60
BLOCKED_URL_HOSTS=

# Optional GA4 property for landing-page and signup funnel measurement.
GA_MEASUREMENT_ID=

# Transactional email. Create a key in Resend; keep it only in Railway/local env.
RESEND_API_KEY=
EMAIL_FROM=corta.la <noreply@corta.la>
ADMIN_TOKEN=
